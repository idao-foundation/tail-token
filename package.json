    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "chai": "6.3.0",
    "dotenv": "18.0.10",
    "ethers": "6.17.0",
    "hardhat": "3.21.2",
    "mocha": "12.0.3",
    "typescript": "7.0.2"
  }
}
