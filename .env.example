# The only variable deployment input: raw 32-byte salt produced by the vanity search.
CREATE2_SALT=

# RPC configuration is needed only for a real BSC mainnet deployment.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Required for both deploy:local and deploy:bsc; must match the fixed search wallet.
# Use its 0x-prefixed private key. Do not commit this secret.
BSC_PRIVATE_KEY=
